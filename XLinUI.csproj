<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.1.0</Version>
    <Author>HanaSi0</Author>
    <Name>XLinUI</Name>
    <Punchline>可自定义聊天、图标顶部栏与多热键栏布局。</Punchline>
    <Description>个人现代 UI：可编辑聊天、图标顶部栏、多热键栏与 Shift 网格吸附、本机背景和字体导入、模糊玻璃、简洁战斗面板；各模块独立开关并可保留原版界面。</Description>
    <RepoUrl>https://github.com/HanaSi0/XLinUI</RepoUrl>
    <Tags>ui;chat;hotbar;personal</Tags>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>
</Project>
